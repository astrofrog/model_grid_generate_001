#####################################
#$ -S /bin/bash
#$ -cwd
#$ -m n
#$ -N JMODEL_NAME
#$ -p -1023
#$ -l h_rt=24:00:00
#$ -o GRIDS_NAME/SET_NAME/log/SHORT_NAME/MODEL_NAME.out
#$ -e GRIDS_NAME/SET_NAME/log/SHORT_NAME/MODEL_NAME.err
#####################################
echo "Starting job "$JOB_ID" to run MODEL_NAME"
source /path/to/conda/bin/activate production
python scripts/3.prepare_hyperion_indiv.py GRIDS_NAME/SET_NAME/par/SHORT_NAME/MODEL_NAME.par
hyperion_sph GRIDS_NAME/SET_NAME/input/SHORT_NAME/MODEL_NAME.rtin GRIDS_NAME/SET_NAME/output/SHORT_NAME/MODEL_NAME.rtout
