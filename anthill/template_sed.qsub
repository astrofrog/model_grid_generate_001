#####################################
#$ -S /bin/bash
#$ -cwd
#$ -m n
#$ -N JMODEL_NAME
#$ -p -1023
#$ -l h_rt=24:00:00
#$ -o GRIDS_NAME/SET_NAME/log/SHORT_NAME/MODEL_NAME_sed.out
#$ -e GRIDS_NAME/SET_NAME/log/SHORT_NAME/MODEL_NAME_sed.err
#####################################
echo "Starting job "$JOB_ID" to run MODEL_NAME"
source /path/to/conda/bin/activate production
python scripts/3.prepare_hyperion_indiv_sed.py GRIDS_NAME/SET_NAME/output/SHORT_NAME/MODEL_NAME.rtout
hyperion_sph GRIDS_NAME/SET_NAME/input/SHORT_NAME/MODEL_NAME_sed.rtin GRIDS_NAME/SET_NAME/output/SHORT_NAME/MODEL_NAME_sed.rtout
